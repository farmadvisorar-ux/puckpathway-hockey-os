# ==============================================================================
# DraftLineup.com - X.com (Twitter) Autopilot Environment Variables (Optional)
# Account: @DraftLineup
# ==============================================================================
# NOTE: The bot runs 100% autonomously out-of-the-box in Autonomous Simulation &
# Ledger Mode without needing any keys. If you wish to dispatch directly to live
# Twitter/X API v2 endpoints, supply your X Developer Portal OAuth 1.0a credentials below:

X_API_KEY=your_x_consumer_key_here
X_API_SECRET=your_x_consumer_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_SECRET=your_x_access_token_secret_here

# Bot Scheduling Cadence (Default: 30 minutes)
X_BOT_CADENCE_MINUTES=30
