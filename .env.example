# DraftLineup.com - Zoho Mail & SMTP Relay Configuration
# Free Zoho Mail Setup (Forever Free Plan: 5 business email accounts, 5GB/user)

# 1. Zoho SMTP Server Host
SMTP_HOST=smtp.zoho.com

# 2. Zoho SMTP Port (TLS / STARTTLS)
SMTP_PORT=587

# 3. Your Zoho Mail Account User
SMTP_USER=hello@draftlineup.com

# 4. Zoho App Password (Generate in Zoho Accounts -> Security -> App Passwords)
# Never use your primary account password; use a generated 16-character App Password.
SMTP_PASS=your_zoho_app_password_here

# 5. Default Sender Address
DEFAULT_SENDER=DraftLineup <hello@draftlineup.com>
